<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CryptinUpdater</AssemblyName>
    <RootNamespace>CryptinUpdater</RootNamespace>
  </PropertyGroup>

  <!-- No reference to CryptinSDK, and none to anything else. This process talks
       to its parent over stdout and shares no types with it: that is the whole
       point of the boundary, and a project reference would quietly undo it. -->

</Project>
